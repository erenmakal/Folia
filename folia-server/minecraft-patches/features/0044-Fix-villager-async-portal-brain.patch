+    private @Nullable ServerLevel folia$deferredBrainInitializationWorld;
     private static final ImmutableList<MemoryModuleType<?>> MEMORY_TYPES = ImmutableList.of(
         MemoryModuleType.HOME,
         MemoryModuleType.JOB_SITE,
@@ -209,6 +210,10 @@ public class Villager extends AbstractVillager implements ReputationEventHandler
 
     @Override
     protected Brain<?> makeBrain(Dynamic<?> dynamic) {
+        final ServerLevel folia$destination = folia$getAsyncTeleportDestinationContext();
+        if (folia$destination != null) {
+            this.folia$deferredBrainInitializationWorld = folia$destination;
+        }
         Brain<Villager> brain = this.brainProvider().makeBrain(dynamic);
         this.registerBrainGoals(brain);
         return brain;
@@ -221,6 +226,25 @@ public class Villager extends AbstractVillager implements ReputationEventHandler
         this.registerBrainGoals(this.getBrain());
     }
 
+    private void folia$updateBrainActivityFromSchedule(final ServerLevel level, final Brain<Villager> villagerBrain) {
+        villagerBrain.updateActivityFromSchedule(level.environmentAttributes(), level.getLevelData().getGameTime(), this.position());
+    }
+
+    private boolean folia$tryCompleteDeferredBrainInitialization(final ServerLevel level) {
+        final ServerLevel folia$destination = this.folia$deferredBrainInitializationWorld;
+        if (folia$destination == null) {
+            return true;
+        }
+        if (level != this.level() || level != folia$destination || !this.inWorld || !this.valid) {
+            return false;
+        }
+
+        this.folia$updateBrainActivityFromSchedule(level, this.getBrain());
+        this.folia$deferredBrainInitializationWorld = null;
+        return true;
+    }
+
     private void registerBrainGoals(Brain<Villager> villagerBrain) {
         Holder<VillagerProfession> holder = this.getVillagerData().profession();
         if (this.isBaby()) {
@@ -250,7 +274,9 @@ public class Villager extends AbstractVillager implements ReputationEventHandler
         villagerBrain.setCoreActivities(ImmutableSet.of(Activity.CORE));
         villagerBrain.setDefaultActivity(Activity.IDLE);
         villagerBrain.setActiveActivityIfPossible(Activity.IDLE);
-        villagerBrain.updateActivityFromSchedule(this.level().environmentAttributes(), this.level().getLevelData().getGameTime(), this.position()); // Folia - region threading - not in the world yet
+        if (this.folia$deferredBrainInitializationWorld == null && this.level() instanceof ServerLevel serverLevel) {
+            this.folia$updateBrainActivityFromSchedule(serverLevel, villagerBrain);
+        }
     }
 
     @Override
@@ -295,9 +321,10 @@ public class Villager extends AbstractVillager implements ReputationEventHandler
     }
     protected void customServerAiStep(ServerLevel level, final boolean inactive) {
         // Paper end - EAR 2
+        final boolean folia$brainReady = this.folia$tryCompleteDeferredBrainInitialization(level);
         ProfilerFiller profilerFiller = Profiler.get();
         profilerFiller.push("villagerBrain");
-        if (!inactive) this.getBrain().tick(level, this); // Paper - EAR 2
+        if (folia$brainReady && !inactive) this.getBrain().tick(level, this); // Paper - EAR 2
         profilerFiller.pop();
         if (this.assignProfessionWhenSpawned) {
             this.assignProfessionWhenSpawned = false;
@@ -404,6 +431,14 @@ public class Villager extends AbstractVillager implements ReputationEventHandler
         this.resetSpecialPrices();
     }
 
+    @Override
+    public void postChangeDimension() {
+        super.postChangeDimension();
+        if (this.level() instanceof ServerLevel serverLevel) {
+            this.folia$tryCompleteDeferredBrainInitialization(serverLevel);
+        }
+    }
+
