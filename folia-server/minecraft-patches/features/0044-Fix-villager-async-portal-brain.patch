From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: erenmakal <69559506+erenmakal@users.noreply.github.com>
Date: Sun, 30 Aug 2026 02:40:00 +0300
Subject: [PATCH] Fix villager brain initialization during async portal teleport

Adapted from PaperMC/Folia PR #446 / issue #431. Villager construction and
NBT restoration can rebuild the brain while an async portal copy is still in a
temporary source/destination world transition. Defer the schedule-dependent
brain initialization until the copied villager is fully installed in the
intended destination world.

The behavior is gated by fixes.region-safety.villager-async-portal-brain in
folia.yml.


diff --git a/net/minecraft/world/entity/Entity.java b/net/minecraft/world/entity/Entity.java
--- a/net/minecraft/world/entity/Entity.java
+++ b/net/minecraft/world/entity/Entity.java
@@ -227,6 +227,7 @@ public abstract class Entity implements SyncedDataHolder, DebugValueSource, Name
     public static final String TAG_INVULNERABLE = "Invulnerable";
     public static final String TAG_CUSTOM_NAME = "CustomName";
     private static final AtomicInteger ENTITY_COUNTER = new AtomicInteger();
+    private static final ThreadLocal<ServerLevel> FOLIA_ASYNC_TELEPORT_DESTINATION_CONTEXT = new ThreadLocal<>();
     public static final int CONTENTS_SLOT_INDEX = 0;
     public static final int BOARDING_COOLDOWN = 60;
     public static final int TOTAL_AIR_SUPPLY = 300;
@@ -4343,8 +4344,24 @@ public abstract class Entity
     protected Entity transformForAsyncTeleport(ServerLevel destination, Vec3 pos, Float yaw, Float pitch, Vec3 velocity) {
         this.removeAfterChangingDimensions(); // remove before so that any CBEntity#getHandle call affects this entity before copying
 
-        Entity copy = this.getType().create(destination, EntitySpawnReason.DIMENSION_TRAVEL);
-        copy.restoreFrom(this);
+        final ServerLevel folia$previousDestination = FOLIA_ASYNC_TELEPORT_DESTINATION_CONTEXT.get();
+        final Entity copy;
+        if (dev.eren.folia.config.FoliaConfig.fixVillagerAsyncPortalBrain) {
+            FOLIA_ASYNC_TELEPORT_DESTINATION_CONTEXT.set(destination);
+        }
+        try {
+            copy = this.getType().create(destination, EntitySpawnReason.DIMENSION_TRAVEL);
+            copy.restoreFrom(this);
+        } finally {
+            if (dev.eren.folia.config.FoliaConfig.fixVillagerAsyncPortalBrain) {
+                if (folia$previousDestination == null) {
+                    FOLIA_ASYNC_TELEPORT_DESTINATION_CONTEXT.remove();
+                } else {
+                    FOLIA_ASYNC_TELEPORT_DESTINATION_CONTEXT.set(folia$previousDestination);
+                }
+            }
+        }
         copy.transform(pos, yaw, pitch, velocity);
         // vanilla code used to call remove _after_ copying, and some stuff is required to be after copy - so add hook here
         // for example, clearing of inventory after switching dimensions
@@ -4354,6 +4371,10 @@ public abstract class Entity
         return copy;
     }
 
+    protected static @Nullable ServerLevel folia$getAsyncTeleportDestinationContext() {
+        return dev.eren.folia.config.FoliaConfig.fixVillagerAsyncPortalBrain ? FOLIA_ASYNC_TELEPORT_DESTINATION_CONTEXT.get() : null;
+    }
+
     public final boolean teleportAsync(TeleportTransition teleportTarget, long teleportFlags,
                                        java.util.function.Consumer<Entity> teleportComplete) {
         PositionMoveRotation move = PositionMoveRotation.calculateAbsolute(PositionMoveRotation.of(this), PositionMoveRotation.of(teleportTarget), teleportTarget.relatives());
diff --git a/net/minecraft/world/entity/npc/villager/Villager.java b/net/minecraft/world/entity/npc/villager/Villager.java
--- a/net/minecraft/world/entity/npc/villager/Villager.java
+++ b/net/minecraft/world/entity/npc/villager/Villager.java
@@ -126,6 +126,7 @@ public class Villager extends AbstractVillager implements ReputationEventHandler
